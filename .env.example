# Copy this file to .env and fill in the values. Never commit the real .env.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# Which provider the LLM abstraction (src/tendersathi/llm) should use.
# Supported now: "groq". "gemini" and "ollama" are wired in later phases.
LLM_PROVIDER=groq

# Groq: free tier, get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (used only if LLM_PROVIDER=gemini): free tier key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ollama (used only if LLM_PROVIDER=ollama): run `ollama serve` locally,
# no API key needed.
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Supabase (Postgres + pgvector storage)
# ---------------------------------------------------------------------------
# Free project at https://supabase.com/dashboard -> New project.
# SUPABASE_URL and SUPABASE_KEY: Project Settings -> API.
SUPABASE_URL=
SUPABASE_KEY=
# DATABASE_URL: Project Settings -> Database -> Connection string (URI).
DATABASE_URL=

# ---------------------------------------------------------------------------
# Langfuse (LLM call tracing)
# ---------------------------------------------------------------------------
# Free account at https://cloud.langfuse.com -> Settings -> API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Telegram notifier (wired up in Phase 6)
# ---------------------------------------------------------------------------
# Create a bot for free via @BotFather on Telegram to get a token.
TELEGRAM_BOT_TOKEN=
# The chat ID (or channel ID) the daily digest should be sent to.
TELEGRAM_CHAT_ID=
