# Copy this file to .env and fill in the values. Never commit the real .env.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# Which provider the LLM abstraction (src/tendersathi/llm) should use.
# Supported now: "groq". "gemini" and "ollama" are wired in later phases.
LLM_PROVIDER=groq

# Groq: free tier, get a key at https://console.groq.com/keys
# Groq's free-tier model lineup (and per-model/per-account TPM limits)
# changes over time; `llama-3.3-70b-versatile` from Phase 0 is no longer
# served. Check `client.models.list()` if this 404s and swap it out.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (used only if LLM_PROVIDER=gemini): free tier key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ollama (used only if LLM_PROVIDER=ollama): run `ollama serve` locally,
# no API key needed.
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Supabase (Postgres + pgvector storage)
# ---------------------------------------------------------------------------
# Free project at https://supabase.com/dashboard -> New project.
# SUPABASE_URL and SUPABASE_KEY: Project Settings -> API.
SUPABASE_URL=
SUPABASE_KEY=
# DATABASE_URL: Project Settings -> Database -> Connection pooling ->
# "Connection string" (Transaction mode). Use the pooler host
# (aws-0-<region>.pooler.supabase.com:6543), not the direct host
# (db.<project-ref>.supabase.co:5432) -- the direct host resolves IPv6-only
# and times out on networks without IPv6 egress.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Langfuse (LLM call tracing)
# ---------------------------------------------------------------------------
# Free account at https://cloud.langfuse.com -> Settings -> API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Email notifier (wired up in Phase 6)
# ---------------------------------------------------------------------------
# Gmail account that sends the daily digest. Needs 2-Step Verification
# enabled on the account, then an App Password from
# https://myaccount.google.com/apppasswords -- NOT the account's real
# password, which won't work for SMTP login.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Who receives the digest. Defaults to GMAIL_ADDRESS (send to yourself) if left blank.
DIGEST_RECIPIENT_EMAIL=
